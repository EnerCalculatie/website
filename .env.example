# RESEND_API_KEY: vereist voor het versturen van e-mail (contactformulier, lead magnet) via Resend.
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# BREVO_API_KEY: vereist voor de nieuwsbrief-inschrijving (double opt-in via Brevo).
BREVO_API_KEY="xkeysib-xxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# BREVO_LIST_ID: numeriek ID van de Brevo-contactlijst waar nieuwsbrief-inschrijvingen aan toegevoegd worden.
BREVO_LIST_ID="0"

# BREVO_TEMPLATE_ID: numeriek ID van de double opt-in e-mailtemplate in Brevo (Campagnes > Transactioneel > Double opt-in).
BREVO_TEMPLATE_ID="0"

# NODE_ENV: zet op "production" om de gebouwde frontend (dist/) te serveren via Express.
NODE_ENV="development"

# PORT: poort waarop de backend luistert (standaard 3001 in lokale ontwikkeling).
PORT="3001"

# CLOUDFLARE_API_TOKEN: Account Analytics Read-token voor het AI-referrer-rapport.
CLOUDFLARE_API_TOKEN="cfut_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# CLOUDFLARE_ACCOUNT_ID: account-ID (Cloudflare dashboard > Overview > API — de
# RUM-analyticsdata zit op account-niveau, niet op zone-niveau).
CLOUDFLARE_ACCOUNT_ID="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
